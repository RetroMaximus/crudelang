# main.crude
VAR p      = PD_BUILD("metro", 360, 220)
VAR r_bpm  = PD_OBJ(p, "r bpm",     30, 40)
VAR metro  = PD_OBJ(p, "metro 500", 30, 80)
VAR s_tick = PD_OBJ(p, "s tick",    30, 120)
VAR r_run  = PD_OBJ(p, "r run",     30, 160)
PD_LINK(p, r_bpm, 0, metro, 1)          # BPM -> period inlet
PD_LINK(p, metro, 0, s_tick, 0)
PD_LINK(p, r_run, 0, metro, 0)          # start / stop
PD_LOAD(p)

VAR title = TEXT("METRONOME")
VAR led   = METER("beat", 0, 1, 0)
VAR bpm   = SLIDER("BPM", 20, 300, 120)
VAR field = NUMBER("BPM", 20, 300, 120)
VAR run   = TOGGLE("Run")
SET(run, "glyph_off", "play")
SET(run, "glyph_on", "pause")

PLACE(title,  16, 12, 200, 20)
PLACE(led,    16, 40,  24, 24)
PLACE(bpm,    56, 40, 200, 24)
PLACE(field, 264, 40,  80, 24)
PLACE(run,    16, 84,  96, 28)

LINK_VALUE(bpm, field)                          # two-way, loop-guarded
ON_CHANGE(bpm, FUNC(v) -> PD_SEND(p, "bpm", v))
ON_CHANGE(run, FUNC(v) -> PD_SEND(p, "run", v))
ON_CHANGE(run, FUNC(v) -> SET(led, "value", 0))
ON_PD(p, "tick", FUNC() -> SET(led, "value", 1))

FUNC on_frame(dt)
    VAR v = GET(led, "value") - dt * 6.0
    IF v < 0 THEN VAR v = 0
    SET(led, "value", v)
END
ON_FRAME(on_frame)