{
  "$schema": "crude/manifest@1",
  "id": "sound-recorder",
  "name": "Sound Recorder",
  "entry": "main.crude",
  "runtime": {
    "mode": "window",
    "width": 1180,
    "height": 720,
    "target_fps": 60,
    "vsync": true
  },
  "ui": {
    "theme": "dark",
    "icons": "generated"
  },
  "audio": {
    "backend": "sounddevice",
    "sample_rate": 44100,
    "block_size": 64,
    "in_channels": 1,
    "out_channels": 2,
    "optional": true
  },
  "pd": {
    "search_paths": ["pd"],
    "build_dir": ".crude_build/pd",
    "patches": []
  },
  "resources": {
    "sounds": ["assets/tone.wav"]
  },
  "loading": {
    "progress": "auto"
  }
}
