{
  "$schema": "crude/manifest@1",
  "id": "fm-synth",
  "name": "FM Synth",
  "entry": "main.crude",
  "runtime": {
    "mode": "window",
    "width": 640,
    "height": 420,
    "target_fps": 60,
    "vsync": true
  },
  "ui": {
    "theme": "dark",
    "icons": "generated",
    "workspaces": ["voices"]
  },
  "audio": {
    "backend": "sounddevice",
    "sample_rate": 44100,
    "block_size": 64,
    "in_channels": 0,
    "out_channels": 2,
    "optional": true
  },
  "pd": {
    "search_paths": ["pd"],
    "build_dir": ".crude_build/pd",
    "patches": []
  },
  "resources": {
    "arrays": [
      { "id": "modindex", "file": "assets/modindex.txt", "format": "text" }
    ],
    "presets": ["presets/*.json"]
  },
  "loading": {
    "progress": "auto"
  }
}
