{
  "$schema": "crude/manifest@1",
  "id": "all-gui",
  "name": "All GUI",
  "entry": "main.crude",
  "runtime": {
    "mode": "window",
    "width": 1180,
    "height": 720,
    "target_fps": 60,
    "vsync": true
  },
  "ui": {
    "theme": "dark",
    "icons": "generated",
    "workspaces": ["controls", "layout", "canvases", "custom", "help"]
  },
  "audio": {
    "backend": "sounddevice",
    "sample_rate": 44100,
    "block_size": 64,
    "in_channels": 2,
    "out_channels": 2,
    "optional": true
  },
  "pd": {
    "patches": []
  },
  "resources": {
    "arrays": [
      { "id": "wave", "file": "assets/wave.txt", "format": "text" }
    ],
    "presets": ["presets/*.json"]
  },
  "loading": {
    "progress": "auto"
  }
}
