# main.crude: a blinking metronome - Pd keeps time and makes the click, the
# script owns the blink, and a slider and a number box edit one value.
#
# This is the plan's worked example, and the shape every windowed project
# follows: author a patch, declare widgets, place them, wire them. The patch
# half (PD_BUILD .. PD_LOAD, PD_SEND, ON_PD) is live now; the widget kinds
# (TEXT METER SLIDER NUMBER TOGGLE, PLACE, LINK_VALUE, ON_CHANGE, ON_FRAME)
# arrive with the window stages, and the plan's acceptance test for this
# example is written against a renderer that records draws instead of one that
# needs a GPU.
#
# Until then this file still loads: in terminal or headless mode the same
# widget tree exists behind a renderer that draws nothing, so the script below
# needs no mode branch - the LED blinks invisibly.
#
# Run it:  python -m crude run examples/metronome

VAR p      = PD_BUILD("metro", 360, 220)
VAR r_bpm  = PD_OBJ(p, "r bpm",     30, 40)
VAR metro  = PD_OBJ(p, "metro 500", 30, 80)
VAR s_tick = PD_OBJ(p, "s tick",    30, 120)
VAR r_run  = PD_OBJ(p, "r run",     30, 160)
PD_LINK(p, r_bpm, metro, 0, 1)         # BPM -> period inlet
PD_LINK(p, metro, s_tick)
PD_LINK(p, r_run, metro)               # start / stop
PD_LOAD(p)

VAR title = TEXT("METRONOME")
VAR led   = METER("beat", 0, 1, 0)
VAR bpm   = SLIDER("BPM", 20, 300, 120)
VAR field = NUMBER("BPM", 20, 300, 120)
VAR run   = TOGGLE("Run")
SET(run, "glyph_off", "play")
SET(run, "glyph_on", "pause")

PLACE(title,  16, 12, 200, 20)
PLACE(led,    16, 40,  24, 24)
PLACE(bpm,    56, 40, 200, 24)
PLACE(field, 264, 40,  80, 24)
PLACE(run,    16, 84,  96, 28)

LINK_VALUE(bpm, field)                          # two-way, loop-guarded
ON_CHANGE(bpm, FUNC(v) -> PD_SEND(p, "bpm", v))
ON_CHANGE(run, FUNC(v) -> PD_SEND(p, "run", v))
ON_CHANGE(run, FUNC(v) -> SET(led, "value", 0))

# Pd's [metro] bangs "tick" on every beat; the handler only sets the LED, so
# nothing here waits on a timer and the frame loop stays the only clock.
ON_PD(p, "tick", FUNC() -> SET(led, "value", 1))

FUNC on_frame(dt)
    VAR v = GET(led, "value") - dt * 6.0
    IF v < 0 THEN VAR v = 0
    SET(led, "value", v)
END
ON_FRAME(on_frame)

# The click itself is Pd's: [metro] -> [s tick] reaches the sample rate as long
# as the stream is running, which a script asks for once the patches exist.
PD_DSP(1)
