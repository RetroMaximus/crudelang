{
  "$schema": "crude/manifest@1",
  "id": "sensor-bridge",
  "name": "Sensor Bridge",
  "entry": "main.crude",
  "runtime": {
    "mode": "window",
    "width": 360,
    "height": 320,
    "target_fps": 50,
    "vsync": false
  },
  "audio": {
    "backend": "sounddevice",
    "sample_rate": 44100,
    "block_size": 64,
    "in_channels": 1,
    "out_channels": 2,
    "optional": true
  },
  "pd": {
    "search_paths": ["pd"],
    "build_dir": ".crude_build/pd",
    "patches": [
      { "id": "sensors", "file": "pd/sensors.pd", "preload": true }
    ]
  },
  "serial": [
    { "id": "arduino", "port": "COM3", "baud": 115200, "codec": "line", "optional": true }
  ],
  "loading": {
    "progress": "console"
  }
}
