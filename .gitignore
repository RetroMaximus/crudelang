# Environments
.venv/
__pycache__/
*.py[cod]

# Generated Pd patch cache (disposable, rebuilt on demand)
.crude_build/
.build_entry

# Test / tooling output
.pytest_cache/
.coverage
htmlcov/

# IDE
.idea/

# Local logs - every project writes one next to itself when it is run
.logs/
logs/

# Vendored binaries (rebuilt / re-fetched on demand)
third-party/
libs/*.dll
libs/*.lib

# Disposable build caches and scratch output
.jsondata/
temp/
logs/*.txt
.qoder/

# PyInstaller output from build.py (regenerated on demand)
dist/
build/
.build_entry/

help_gen.py
pull_latest.sh
push_to_git.sh